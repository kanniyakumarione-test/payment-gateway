# AuraPay Backend Environment Variables
# Copy this to .env and fill in your credentials

PORT=5000

# Supabase Configuration (Use SERVICE_ROLE_KEY for server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Admin Configuration
# You will need to provide the path to your service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
